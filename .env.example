# Stray configuration
# Copy this file to .env and fill in your values, or run bin/setup-wizard

# Instance
STRAY_INSTANCE_NAME=Stray
STRAY_INSTANCE_DOMAIN=localhost

# Security
SECRET_KEY_BASE=

# Encryption key for DB-stored secrets (SMTP password, AI API key)
# Generate one with: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
STRAY_ENCRYPTION_KEY=

# AI provider (NONE, OLLAMA, OPENAI_COMPATIBLE)
# Everything works without AI. NONE = zero-shot embedding tagging only (local model).
# OLLAMA = local Ollama instance for LLM tagging
# OPENAI_COMPATIBLE = any OpenAI-compatible API endpoint
STRAY_AI_PROVIDER__NAME=NONE
STRAY_AI_PROVIDER__URL=
STRAY_AI_PROVIDER__API_KEY=

# SMTP (optional - needed for password reset emails)
# Leave blank to skip email. Passwords can be reset via rails console.
STRAY_SMTP__HOST=
STRAY_SMTP__PORT=587
STRAY_SMTP__USERNAME=
STRAY_SMTP__PASSWORD=

# Background jobs run inside the web process by default (single-process deploy).
# Set to "true" to enable the in-process Solid Queue supervisor. This is the
# recommended default for self-hosting; only split jobs out to a dedicated
# process when you need to scale past one server.
SOLID_QUEUE_IN_PUMA=true
# Set to "fork" to run Solid Queue as a forked child process instead of threads.
# SOLID_QUEUE_MODE=async

