<% if defined?(@tags) && @tags&.any? %>
  <div id="tag-bar" class="border-b-3 border-charcoal bg-champagne-50 backdrop-blur shadow-sm sticky top-[var(--navbar-h)] z-40">
    <div class="flex items-center overflow-x-auto whitespace-nowrap px-2 md:px-4 lg:px-16 py-2 gap-1">
      <% active_class = "border-b-6 border-carrot font-semibold text-carrot" %>
      <% inactive_class = "border-b-6 border-transparent text-charcoal hover:text-carrot" %>
      <% tag_link_class = " px-3 py-1 text-sm whitespace-nowrap" %>

      <%= link_to "All",
        root_path(request.query_parameters.except("tag", "page")),
        class: (@tag.blank? ? active_class : inactive_class) + tag_link_class %>

      <% visible_tags = @tags.first(10) %>
      <% overflow_tags = @tags.drop(10) %>

      <% visible_tags.each do |tag| %>
        <%= link_to tag.name,
          root_path(request.query_parameters.except("page").merge(tag: tag.name)),
          class: (@tag == tag.name ? active_class : inactive_class) + tag_link_class %>
      <% end %>

      <% if overflow_tags.any? %>
        <div data-controller="dropdown" class="relative shrink-0">
          <button type="button"
                  data-dropdown-target="button"
                  data-action="dropdown#toggle click@window->dropdown#hide"
                  aria-expanded="false"
                  aria-controls="tag-bar-more-dropdown"
                  aria-label="More tags"
                  class="<%= inactive_class + tag_link_class %> flex items-center gap-0.5 cursor-pointer">
            More
            <%= phosphor_icon "caret-down", class: "w-3 h-3" %>
          </button>

          <div id="tag-bar-more-dropdown"
               data-dropdown-target="menu"
               class="hidden absolute left-0 mt-1 z-20 w-48 max-w-[calc(100vw-1.5rem)] max-h-80 overflow-y-auto rounded-md border-3 border-charcoal bg-athens-400 p-1 shadow-lg
                      transition transform origin-top-left
                      data-[transition-enter-from]:opacity-0 data-[transition-enter-to]:opacity-100
                      data-[transition-leave-from]:opacity-100 data-[transition-leave-to]:opacity-0">
            <% overflow_tags.each do |tag| %>
              <%= link_to tag.name,
                root_path(request.query_parameters.except("page").merge(tag: tag.name)),
                class: "block px-2 py-1 text-sm text-charcoal hover:bg-athens-300 hover:text-carrot-600 rounded whitespace-nowrap" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
