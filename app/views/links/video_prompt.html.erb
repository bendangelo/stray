<% title "Add video" %>

<main class="container mx-auto px-4 pt-4 max-w-xl">
  <div class="border-3 border-charcoal rounded-md bg-athens-400 p-6">
    <h1 class="font-display text-xl font-bold text-charcoal mb-2 flex items-center gap-2">
      <%= phosphor_icon "video", style: :bold, class: "w-5 h-5" %>
      This is a single video
    </h1>
    <p class="text-sm text-charcoal-300 mb-4">Follow the channel to get future videos from the same creator, or save just this one video without subscribing.</p>

    <div class="flex flex-col gap-3">
      <%= form_with url: links_path do |form| %>
        <%= hidden_field_tag :url, @url %>
        <%= hidden_field_tag :follow_channel, "true" %>
        <%= form.submit "Follow channel",
              class: "w-full bg-carrot-500 hover:bg-carrot-600 text-white font-bold text-sm px-4 py-3 rounded-md border-3 border-charcoal cursor-pointer" %>
      <% end %>

      <%= form_with url: links_path do |form| %>
        <%= hidden_field_tag :url, @url %>
        <%= hidden_field_tag :follow_channel, "false" %>
        <%= form.submit "Just this video",
              class: "w-full bg-athens-200 hover:bg-athens-300 text-charcoal font-bold text-sm px-4 py-3 rounded-md border-3 border-charcoal cursor-pointer" %>
      <% end %>
    </div>
  </div>
</main>
