<% title @source.display_name %>

<div class="container mx-auto px-4 pt-4 max-w-screen-xl xl:max-w-screen-2xl">
  <%= turbo_stream_from "user_#{current_user.id}_sources" %>
  <div class="mb-4">
    <%= link_to "← Sources", sources_path, class: "text-sm text-charcoal underline hover:no-underline" %>
    <div class="flex items-start justify-between gap-2 mt-2">
      <div class="flex items-center gap-3">
        <%= source_icon(@source) %>
        <div>
          <h1 class="font-display text-2xl font-bold text-charcoal"><%= @source.display_name %></h1>
          <div class="flex items-center gap-3 mt-1 text-xs text-charcoal-300">
            <span><%= @source.kind.humanize %></span>
            <% if @source.pending? %>
              <span class="flex items-center gap-1 text-charcoal font-bold">
                <%= phosphor_icon "spinner-gap", class: "w-3 h-3 animate-spin" %>
                Resolving…
              </span>
              <% if @source.stuck_pending? %>
                <span class="text-cerise font-bold" title="No successful poll yet. Check the jobs dashboard for a queued or failed job.">stuck</span>
              <% end %>
            <% elsif @source.recovering? %>
              <span class="flex items-center gap-1 text-carrot-500 font-bold" title="<%= @source.last_error %>">
                <%= phosphor_icon "arrow-clockwise", class: "w-3 h-3 animate-spin" %>
                Retrying<%= " #{time_until(@source.next_crawl_at)}" if @source.next_crawl_at %>
              </span>
              <% if @source.last_error.present? %>
                <span class="text-cerise">· error: <%= @source.last_error %></span>
              <% end %>
            <% elsif @source.failed? %>
              <span class="text-cerise font-bold">Failed</span>
            <% elsif @source.ok? %>
              <span class="text-mint-700 font-bold">OK</span>
            <% end %>
            <% if @source.polling? %>
              <span class="text-charcoal font-bold">· polling</span>
            <% end %>
            <span>· <%= @total_count %> items</span>
            <% if @source.last_polled_at %>
              <span>· polled <%= time_ago(@source.last_polled_at) %></span>
            <% end %>
            <% if @source.next_crawl_at %>
              <span title="<%= @source.next_crawl_at.iso8601 %>">· next poll <%= time_until(@source.next_crawl_at) %></span>
            <% end %>
            <% if @source.poll_interval.present? && @source.poll_interval.positive? %>
              <span>· every <%= @source.poll_interval %>s</span>
            <% else %>
              <span>· adaptive</span>
            <% end %>
            <% if @source.failed? && @source.last_error %>
              <span class="text-cerise">· error: <%= @source.last_error %></span>
              <% if @source.last_error_at %>
                <span class="text-cerise">(<%= time_ago(@source.last_error_at) %>)</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-wrap" data-test="source-actions">
        <%= render "sources/collection_menu",
              source: @source,
              collections: @collections,
              member_collection_ids: @member_collection_ids %>
        <% if @source.polling? %>
          <span class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border-2 border-charcoal bg-athens-500 text-charcoal text-xs font-bold cursor-wait">
            <%= phosphor_icon "spinner-gap", class: "w-4 h-4 animate-spin" %>
            Pulling…
          </span>
        <% else %>
          <%= button_to pull_source_path(@source), method: :post, title: "Pull now",
                class: "flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border-2 border-charcoal bg-white text-charcoal hover:bg-athens-500 cursor-pointer text-xs font-bold" do %>
            <%= phosphor_icon "arrows-clockwise", class: "w-4 h-4" %>
            Pull now
          <% end %>
        <% end %>
        <% if @source.active? %>
          <%= action_link_to source_path(@source), method: :patch,
                params: { source: { active: false } },
                data: { turbo_frame: "_top" },
                class: "flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border-2 border-charcoal bg-white text-charcoal hover:bg-athens-500 cursor-pointer text-xs font-bold" do %>
            <%= phosphor_icon "pause", class: "w-4 h-4" %>
            Pause
          <% end %>
        <% else %>
          <%= action_link_to source_path(@source), method: :patch,
                params: { source: { active: true } },
                data: { turbo_frame: "_top" },
                class: "flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border-2 border-charcoal bg-white text-charcoal hover:bg-athens-500 cursor-pointer text-xs font-bold" do %>
            <%= phosphor_icon "play", class: "w-4 h-4" %>
            Unpause
          <% end %>
        <% end %>
        <%= link_to edit_source_path(@source),
              class: "flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border-2 border-charcoal bg-white text-charcoal hover:bg-athens-500 cursor-pointer text-xs font-bold" do %>
          <%= phosphor_icon "pencil", class: "w-4 h-4" %>
          Edit
        <% end %>
        <%= action_link_to source_path(@source), method: :delete,
              confirm: "Delete this source and all its items?",
              class: "flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border-2 border-cerise bg-white text-cerise hover:bg-cerise/10 cursor-pointer text-xs font-bold" do %>
          <%= phosphor_icon "trash", class: "w-4 h-4" %>
          Delete
        <% end %>
      </div>
    </div>
  </div>

  <details class="mb-4 border-3 border-charcoal rounded-md bg-athens-400">
    <summary class="px-3 py-2 cursor-pointer text-xs font-bold text-charcoal flex items-center gap-1">
      <%= phosphor_icon "magnifying-glass", class: "w-3.5 h-3.5" %>
      Source details
    </summary>
    <dl class="px-3 pb-3 pt-1 text-xs text-charcoal space-y-1">
      <div class="flex flex-wrap gap-1 items-baseline">
        <dt class="font-bold text-charcoal-300"><%= source_ingest_label(@source) %>:</dt>
        <dd><%= link_to @source.url, @source.url, target: "_blank", rel: "nofollow noopener", class: "underline hover:no-underline break-all" %></dd>
      </div>
      <% if @source.channel_url.present? && @source.channel_url != @source.url %>
        <div class="flex flex-wrap gap-1 items-baseline">
          <dt class="font-bold text-charcoal-300">Channel page:</dt>
          <dd><%= link_to @source.channel_url, @source.channel_url, target: "_blank", rel: "nofollow noopener", class: "underline hover:no-underline break-all" %></dd>
        </div>
      <% end %>
      <% if @source.external_id.present? %>
        <div class="flex flex-wrap gap-1 items-baseline">
          <dt class="font-bold text-charcoal-300">External ID:</dt>
          <dd class="font-mono break-all"><%= @source.external_id %></dd>
        </div>
      <% end %>
      <% if @source.bridge_class %>
        <div class="flex flex-wrap gap-1 items-baseline">
          <dt class="font-bold text-charcoal-300">Bridge:</dt>
          <dd class="font-mono"><%= @source.bridge_class.name %></dd>
        </div>
      <% end %>
      <% if source_kind_note(@source).present? %>
        <p class="text-charcoal-300 pt-1"><%= source_kind_note(@source) %></p>
      <% end %>
      <%= render "sources/weight_bar", source: @source, follow: @follow %>
    </dl>
    <div class="px-3 pb-3 pt-2 border-t-2 border-charcoal/10">
      <div class="flex items-center gap-1 mb-2">
        <%= phosphor_icon "share-network", class: "w-3.5 h-3.5" %>
        <span class="font-bold text-charcoal">Share</span>
      </div>
      <p class="text-xs text-charcoal-300 mb-2">Anyone with these links can view. The slug is the secret. Rotate to revoke.</p>
      <div class="space-y-2">
        <%= render "shared/clipboard_field",
              label: "Manifest (Stray-to-Stray)",
              value: "#{request.base_url}#{source_manifest_path(slug: @source.slug)}" %>
        <%= render "shared/clipboard_field",
              label: "RSS feed (any reader)",
              value: "#{request.base_url}#{source_feed_path(slug: @source.slug)}" %>
        <%= render "shared/clipboard_field",
              label: "Public preview page",
              value: "#{request.base_url}#{public_source_path(slug: @source.slug)}" %>
      </div>
      <div class="mt-3 pt-3 border-t-2 border-charcoal/10">
        <%= button_to rotate_slug_source_path(@source), method: :post,
              data: { turbo_confirm: "Rotate the slug? All existing share links will stop working." },
              class: "flex items-center gap-1 px-2 py-1 rounded-md border-2 border-charcoal bg-white text-cerise hover:bg-athens-500 cursor-pointer text-xs font-bold" do %>
          <%= phosphor_icon "arrows-clockwise", class: "w-3.5 h-3.5" %>
          Rotate slug
        <% end %>
      </div>
    </div>
  </details>

  <%= turbo_frame_tag dom_id(@source, :items) do %>
    <div class="mb-4 flex items-center gap-2 flex-wrap">
      <% [["1m", "Last month"], ["3m", "Last 3 months"], ["1y", "Last year"], ["all", "All time"]].each do |since, label| %>
        <% active = (@since == since) %>
        <%= link_to label, source_path(@source, since: since),
              data: { turbo_frame: dom_id(@source, :items) },
              class: "px-3 py-1 text-xs font-bold rounded-md border-3 border-charcoal #{active ? 'bg-mint text-charcoal' : 'bg-athens-400 text-charcoal hover:bg-athens-500'}" %>
      <% end %>
    </div>

    <% if @since != "all" %>
      <p class="text-xs text-charcoal-300 mb-2">
        Showing <%= @pagy.count %> of <%= @total_count %> items
      </p>
    <% end %>

    <% if @items.any? %>
      <div class="grid grid-cols-12 gap-y-4 mx-auto mb-4 gap-x-2"
           data-controller="player">
        <div class="col-span-12 hidden border-y-3 border-charcoal"
             data-player-target="playerBox">
          <p class="p-4 text-center text-charcoal-300">Loading...</p>
        </div>

        <%= render partial: "items/item", collection: @items, as: :item %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-4 flex justify-center gap-2 text-sm">
          <% if @pagy.previous %>
            <%= link_to "← Newer", source_path(@source, page: @pagy.previous, since: @since), class: "text-charcoal underline hover:no-underline" %>
          <% end %>
          <span class="text-charcoal-300"><%= @pagy.page %> / <%= @pagy.pages %></span>
          <% if @pagy.next %>
            <%= link_to "Older →", source_path(@source, page: @pagy.next, since: @since), class: "text-charcoal underline hover:no-underline" %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="border-3 border-charcoal rounded-md bg-athens-400 p-8 text-center">
        <p class="text-charcoal-300">No items from this source yet.</p>
      </div>
    <% end %>
  <% end %>
</div>
