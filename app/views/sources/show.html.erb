<div class="container mx-auto px-4 pt-4 pb-16 max-w-screen-xl">
  <div class="mb-4">
    <%= link_to "← Sources", sources_path, class: "text-sm text-charcoal underline hover:no-underline" %>
    <div class="flex items-start justify-between gap-2 mt-2">
      <div class="flex items-center gap-3">
        <%= source_icon(@source) %>
        <div>
          <h1 class="font-display text-2xl font-bold text-charcoal"><%= @source.name %></h1>
          <div class="flex items-center gap-3 mt-1 text-xs text-charcoal-300">
            <span><%= @source.kind.humanize %></span>
            <% if @source.last_polled_at %>
              <span>· polled <%= time_ago(@source.last_polled_at) %></span>
            <% end %>
            <% if @source.next_crawl_at %>
              <span>· next poll <%= time_ago(@source.next_crawl_at) %></span>
            <% end %>
            <% if @source.last_error %>
              <span class="text-cerise">· error: <%= @source.last_error %></span>
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <% if @source.active? %>
          <%= button_to "Pause", source_path(@source), method: :patch, params: { source: { active: false } },
                form: { data: { turbo_frame: "_top" } },
                class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <% else %>
          <%= button_to "Unpause", source_path(@source), method: :patch, params: { source: { active: true } },
                form: { data: { turbo_frame: "_top" } },
                class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <% end %>
        <%= link_to "Edit", edit_source_path(@source), class: "text-xs text-charcoal underline hover:no-underline" %>
        <%= button_to "Delete", source_path(@source), method: :delete,
              form: { data: { turbo_confirm: "Delete this source and all its items?" } },
              class: "text-xs text-cerise underline hover:no-underline cursor-pointer bg-transparent border-none" %>
      </div>
    </div>
  </div>

  <div class="mb-4 flex items-center gap-3 border-3 border-charcoal rounded-md bg-athens-400 p-3">
    <span id="<%= dom_id(@source, :weight) %>" class="text-sm text-charcoal">Weight: <%= @follow.weight %></span>
    <% if @follow.weight != 1.0 %>
      <%= button_to "Reset", source_path(@source), method: :patch, params: { reset_weight: true },
        form: { data: { turbo_stream: true } },
        class: "text-sm text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
    <% end %>
  </div>

  <% if @items.any? %>
    <div class="grid grid-cols-12 gap-y-4 max-w-screen-xl mx-auto mb-4 gap-x-2"
         data-controller="player">
      <div class="col-span-12 hidden border-y-3 border-charcoal"
           data-player-target="playerBox">
        <p class="p-4 text-center text-charcoal-300">Loading...</p>
      </div>

      <%= render partial: "items/item", collection: @items, as: :item %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-4 flex justify-center gap-2 text-sm">
        <% if @pagy.previous %>
          <%= link_to "← Newer", source_path(@source, page: @pagy.previous), class: "text-charcoal underline hover:no-underline" %>
        <% end %>
        <span class="text-charcoal-300"><%= @pagy.page %> / <%= @pagy.pages %></span>
        <% if @pagy.next %>
          <%= link_to "Older →", source_path(@source, page: @pagy.next), class: "text-charcoal underline hover:no-underline" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="border-3 border-charcoal rounded-md bg-athens-400 p-8 text-center">
      <p class="text-charcoal-300">No items from this source yet.</p>
    </div>
  <% end %>
</div>
