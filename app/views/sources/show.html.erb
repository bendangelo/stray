<% title @source.display_name %>

<div class="container mx-auto px-4 pt-4 max-w-screen-xl xl:max-w-screen-2xl">
  <%= turbo_stream_from "user_#{current_user.id}_sources" %>
  <div class="mb-4">
    <%= link_to "← Sources", sources_path, class: "text-sm text-charcoal underline hover:no-underline" %>
    <div class="flex items-start justify-between gap-2 mt-2">
      <div class="flex items-center gap-3">
        <%= source_icon(@source) %>
        <div>
          <h1 class="font-display text-2xl font-bold text-charcoal"><%= @source.display_name %></h1>
          <div class="flex items-center gap-3 mt-1 text-xs text-charcoal-300">
            <span><%= @source.kind.humanize %></span>
            <% if @source.pending? %>
              <span class="flex items-center gap-1 text-charcoal font-bold">
                <%= phosphor_icon "spinner-gap", class: "w-3 h-3 animate-spin" %>
                Resolving…
              </span>
            <% elsif @source.failed? %>
              <span class="text-cerise font-bold">Failed</span>
            <% end %>
            <span>· <%= @total_count %> items</span>
            <% if @source.last_polled_at %>
              <span>· polled <%= time_ago(@source.last_polled_at) %></span>
            <% end %>
            <% if @source.next_crawl_at %>
              <span>· next poll <%= time_ago(@source.next_crawl_at) %></span>
            <% end %>
            <% if @source.poll_interval.present? && @source.poll_interval.positive? %>
              <span>· every <%= @source.poll_interval %>s</span>
            <% else %>
              <span>· adaptive</span>
            <% end %>
            <% if @source.last_error %>
              <span class="text-cerise">· error: <%= @source.last_error %></span>
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-wrap" data-test="source-actions">
        <% if @source.polling? %>
          <span class="flex items-center gap-1 px-2 py-1 rounded-md border-2 border-charcoal bg-athens-500 text-charcoal text-xs font-bold cursor-wait">
            <%= phosphor_icon "spinner-gap", class: "w-3.5 h-3.5 animate-spin" %>
            Pulling…
          </span>
        <% else %>
          <%= button_to pull_source_path(@source), method: :post, title: "Pull now",
                class: "flex items-center gap-1 px-2 py-1 rounded-md border-2 border-charcoal bg-white text-charcoal hover:bg-athens-500 cursor-pointer text-xs font-bold" do %>
            <%= phosphor_icon "arrows-clockwise", class: "w-3.5 h-3.5" %>
            Pull now
          <% end %>
        <% end %>
        <% if @source.active? %>
          <%= action_link_to "Pause", source_path(@source), method: :patch,
                params: { source: { active: false } },
                data: { turbo_frame: "_top" },
                class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <% else %>
          <%= action_link_to "Unpause", source_path(@source), method: :patch,
                params: { source: { active: true } },
                data: { turbo_frame: "_top" },
                class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <% end %>
        <%= link_to "Edit", edit_source_path(@source), class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <%= action_link_to "Delete", source_path(@source), method: :delete,
              confirm: "Delete this source and all its items?",
              class: "text-xs text-cerise underline hover:no-underline cursor-pointer bg-transparent border-none" %>
      </div>
    </div>
  </div>

  <%= render "sources/weight_bar", source: @source, follow: @follow %>

  <%= turbo_frame_tag dom_id(@source, :items) do %>
    <div class="mb-4 flex items-center gap-2 flex-wrap">
      <% [["1m", "Last month"], ["3m", "Last 3 months"], ["1y", "Last year"], ["all", "All time"]].each do |since, label| %>
        <% active = (@since == since) %>
        <%= link_to label, source_path(@source, since: since),
              data: { turbo_frame: dom_id(@source, :items) },
              class: "px-3 py-1 text-xs font-bold rounded-md border-3 border-charcoal #{active ? 'bg-mint text-charcoal' : 'bg-athens-400 text-charcoal hover:bg-athens-500'}" %>
      <% end %>
    </div>

    <% if @since != "all" %>
      <p class="text-xs text-charcoal-300 mb-2">
        Showing <%= @pagy.count %> of <%= @total_count %> items
      </p>
    <% end %>

    <% if @items.any? %>
      <div class="grid grid-cols-12 gap-y-4 mx-auto mb-4 gap-x-2"
           data-controller="player">
        <div class="col-span-12 hidden border-y-3 border-charcoal"
             data-player-target="playerBox">
          <p class="p-4 text-center text-charcoal-300">Loading...</p>
        </div>

        <%= render partial: "items/item", collection: @items, as: :item %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-4 flex justify-center gap-2 text-sm">
          <% if @pagy.previous %>
            <%= link_to "← Newer", source_path(@source, page: @pagy.previous, since: @since), class: "text-charcoal underline hover:no-underline" %>
          <% end %>
          <span class="text-charcoal-300"><%= @pagy.page %> / <%= @pagy.pages %></span>
          <% if @pagy.next %>
            <%= link_to "Older →", source_path(@source, page: @pagy.next, since: @since), class: "text-charcoal underline hover:no-underline" %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="border-3 border-charcoal rounded-md bg-athens-400 p-8 text-center">
        <p class="text-charcoal-300">No items from this source yet.</p>
      </div>
    <% end %>
  <% end %>
</div>
