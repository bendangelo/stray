<%= form_with model: source, url: source.new_record? ? sources_path : source_path(source) do |form| %>
  <% if source.errors.any? %>
    <div class="mb-4 border-3 border-cerise rounded-md bg-athens-400 p-3">
      <% source.errors.full_messages.each do |message| %>
        <p class="text-sm text-cerise"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-3">
    <div>
      <%= form.label :url, class: ui_label %>
      <%= form.url_field :url, class: ui_input %>
    </div>

    <div>
      <%= form.label :kind, class: ui_label %>
      <%= form.select :kind, Source.kinds.keys.map { |k| [k.humanize, k] }, {},
            class: ui_select %>
    </div>

    <div>
      <%= form.label :name, class: ui_label %>
      <%= form.text_field :name, class: ui_input %>
    </div>

    <div>
      <%= form.label :icon_url, "Icon URL (optional)", class: ui_label %>
      <%= form.url_field :icon_url, class: ui_input %>
    </div>

    <div>
      <%= form.label :poll_interval, "Poll interval (seconds, optional)", class: ui_label %>
      <%= form.number_field :poll_interval, min: 60, placeholder: "e.g. 1800",
            class: ui_input %>
      <p class="text-xs text-charcoal-300 mt-1">Leave blank for automatic adaptive scheduling.</p>
    </div>

    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "h-4 w-4 border-3 border-charcoal" %>
      <%= form.label :active, "Active (polling enabled)", class: "text-sm text-charcoal" %>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= form.submit source.new_record? ? "Add source" : "Save", class: ui_button %>
      <%= link_to "Cancel", sources_path,
            class: "text-sm text-charcoal underline hover:no-underline" %>
    </div>
  </div>
<% end %>
