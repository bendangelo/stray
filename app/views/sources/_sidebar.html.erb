<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-40 w-64 border-r-3 border-charcoal bg-champagne overflow-y-auto transition-transform duration-200 -translate-x-full md:translate-x-0 md:static md:w-52 lg:w-60 md:z-0"
       data-sidebar-target="sidebar">
  <div class="p-4">
    <h2 class="font-display text-sm font-bold text-charcoal mb-3 uppercase tracking-wide">Sources</h2>

    <div class="space-y-1">
      <% if @sources&.any? %>
        <% unseen_counts = Item.where(source_id: @sources.map(&:id), state: :unseen).group(:source_id).count %>
      <% else %>
        <% unseen_counts = {} %>
      <% end %>

      <% @sources&.each do |source| %>
        <% active = @source.present? && source.id == @source.id %>
        <div class="flex items-center gap-1 rounded-md hover:bg-athens-400 <%= active ? "bg-athens-400 border-l-3 border-carrot-500" : "" %>">
          <%= link_to source_path(source), class: "flex items-center gap-2 flex-1 min-w-0 p-2" do %>
            <img src="<%= source_icon_url(source) || missing_thumb %>"
                 alt=""
                 class="w-8 h-8 rounded border-2 border-charcoal object-cover shrink-0"
                 loading="lazy">

            <span class="flex-1 text-sm text-charcoal truncate <%= "font-bold" if active %>">
              <%= source.display_name %>
              <% if source.pending? %>
                <span class="flex items-center gap-1 text-xs text-charcoal-300 font-normal">
                  <%= phosphor_icon "spinner-gap", class: "w-3 h-3 animate-spin" %>
                  Resolving…
                </span>
              <% elsif source.failed? %>
                <span class="text-xs text-cerise font-normal" title="<%= source.last_error %>">Failed</span>
              <% end %>
            </span>

            <% if unseen_counts[source.id].to_i > 0 %>
              <span class="text-xs font-bold text-champagne bg-carrot-500 px-1.5 py-0.5 rounded-full">
                <%= unseen_counts[source.id] %>
              </span>
            <% end %>
          <% end %>

          <%= render "sources/sidebar_source_menu", source: source, current_user_id: current_user.id %>
        </div>
      <% end %>
    </div>

    <%= link_to "All Sources", sources_path, class: "block mt-4 text-sm text-charcoal underline hover:no-underline" %>

    <h2 class="font-display text-sm font-bold text-charcoal mt-6 mb-3 uppercase tracking-wide">Collections</h2>

    <div class="space-y-1">
      <% @collections&.each do |collection| %>
        <% active = @collection.present? && collection.id == @collection.id %>
        <div class="flex items-center gap-1 rounded-md hover:bg-athens-400 <%= active ? "bg-athens-400 border-l-3 border-carrot-500" : "" %>">
          <%= link_to collection_path(collection), class: "flex items-center gap-2 flex-1 min-w-0 p-2" do %>
            <span class="flex-1 text-sm text-charcoal truncate <%= "font-bold" if active %>">
              <%= collection.name %>
            </span>
          <% end %>

          <%= render "collections/sidebar_collection_menu", collection: collection %>
        </div>
      <% end %>
    </div>

    <%= link_to "All Collections", collections_path, class: "block mt-4 text-sm text-charcoal underline hover:no-underline" %>
  </div>
</aside>
