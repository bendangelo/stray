<%= turbo_frame_tag dom_id(source, "collection_row_#{collection.id}") do %>
  <% if member %>
    <%= button_to collection_membership_path(source.collection_memberships.find_by(collection: collection)),
          method: :delete,
          form: { data: { turbo_stream: true } },
          class: dropdown_menu_item_class do %>
      <%= phosphor_icon "check", style: :bold, class: "w-3.5 h-3.5" %>
      <span class="flex-1 truncate">Remove from <%= collection.name %></span>
    <% end %>
  <% else %>
    <%= button_to collection_memberships_path,
          method: :post,
          params: { collection_membership: { source_id: source.id, collection_id: collection.id } },
          form: { data: { turbo_stream: true } },
          class: dropdown_menu_item_class do %>
      <%= phosphor_icon "folder-simple", class: "w-3.5 h-3.5" %>
      <span class="flex-1 truncate"><%= collection.name %></span>
    <% end %>
  <% end %>
<% end %>
