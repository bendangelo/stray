<div id="<%= dom_id(source, :weight_bar) %>" class="flex flex-wrap gap-1 items-baseline">
  <dt class="font-bold text-charcoal-300">Weight:</dt>
  <dd id="<%= dom_id(source, :weight) %>" class="flex flex-wrap items-center gap-1">
    <span><%= follow.weight %></span>
    <% if follow.weight != 1.0 %>
      <%= action_link_to "Reset", source_path(source), method: :patch, params: { reset_weight: true },
        data: { turbo_stream: true },
        class: "underline hover:no-underline cursor-pointer bg-transparent border-none" %>
    <% end %>
    <% if follow.muted %>
      <span class="text-cerise">· muted</span>
      <%= action_link_to "Unmute", unmute_source_path(source), method: :post,
        data: { turbo_stream: true },
        class: "underline hover:no-underline cursor-pointer bg-transparent border-none" %>
    <% end %>
  </dd>
</div>
