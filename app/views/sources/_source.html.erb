<%= turbo_frame_tag dom_id(source) do %>
  <div class="border-3 border-charcoal rounded-md bg-athens-400 p-4 hover:bg-athens-500
              <%= " opacity-50" unless source.active? %>">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <%= source_icon(source, size: "w-10 h-10") %>
        <div class="min-w-0">
          <%= link_to source_path(source), class: "block", data: { turbo_frame: "_top" } do %>
            <span class="font-display font-bold text-charcoal truncate"><%= source.display_name %></span>
          <% end %>
          <div class="text-xs text-charcoal-300 flex items-center flex-wrap gap-x-2 mt-1.5">
            <span><%= source.kind.humanize %></span>
            <% if source.pending? %>
              <span class="flex items-center gap-1 text-charcoal font-bold">
                <%= phosphor_icon "spinner-gap", class: "w-3 h-3 animate-spin" %>
                Resolving…
              </span>
              <% if source.stuck_pending? %>
                <span class="text-cerise font-bold" title="No successful poll yet. Check the jobs dashboard for a queued or failed job.">stuck</span>
              <% end %>
            <% elsif source.failed? %>
              <span class="text-cerise font-bold" title="<%= source.last_error %>">Failed</span>
            <% elsif source.ok? %>
              <span class="text-mint-700 font-bold">OK</span>
            <% end %>
            <% if source.items.unseen.any? %>
              <span class="bg-mint text-charcoal text-[10px] font-bold px-1.5 rounded-full">
                <%= source.items.unseen.count %> new
              </span>
            <% end %>
            <span>· <%= source.items.count %> items</span>
            <% if source.last_polled_at %>
              <span>· polled <%= time_ago(source.last_polled_at) %></span>
            <% end %>
            <% if source.next_crawl_at && source.active? %>
              <span>· next <%= time_ago(source.next_crawl_at) %></span>
            <% end %>
            <% if source.failed? && source.last_error %>
              <span class="text-cerise" title="<%= source.last_error %>">· error</span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <% if source.polling? %>
          <span class="flex items-center gap-1 px-2 py-1 rounded-md border-2 border-charcoal bg-athens-500 text-charcoal text-xs font-bold cursor-wait">
            <%= phosphor_icon "spinner-gap", class: "w-3.5 h-3.5 animate-spin" %>
            Pulling…
          </span>
        <% else %>
          <%= button_to pull_source_path(source), method: :post, title: "Pull now",
                class: "flex items-center gap-1 px-2 py-1 rounded-md border-2 border-charcoal bg-white text-charcoal hover:bg-athens-500 cursor-pointer text-xs font-bold",
                form: { data: { turbo_frame: "_top" } } do %>
            <%= phosphor_icon "arrows-clockwise", class: "w-3.5 h-3.5" %>
            Pull
          <% end %>
        <% end %>
        <% if source.active? %>
          <%= action_link_to "Pause", source_path(source), method: :patch, params: { source: { active: false } },
                data: { turbo_frame: "_top" },
                class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <% else %>
          <%= action_link_to "Unpause", source_path(source), method: :patch, params: { source: { active: true } },
                data: { turbo_frame: "_top" },
                class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none" %>
        <% end %>
        <%= link_to "Edit", edit_source_path(source),
              class: "text-xs text-charcoal underline hover:no-underline cursor-pointer bg-transparent border-none",
              data: { turbo_frame: "_top" } %>
        <%= action_link_to "Delete", source_path(source), method: :delete,
              confirm: "Delete this source and all its items?",
              data: { turbo_frame: "_top" },
              class: "text-xs text-cerise underline hover:no-underline cursor-pointer bg-transparent border-none" %>
      </div>
    </div>
  </div>
<% end %>
