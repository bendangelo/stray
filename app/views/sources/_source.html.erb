<%= turbo_frame_tag dom_id(source), class: "block" do %>
  <div class="border-3 border-charcoal rounded-md bg-athens-400 p-4 hover:bg-athens-500
              <%= " opacity-50" unless source.active? %>">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <%= source_icon(source, size: "w-10 h-10") %>
        <div class="min-w-0">
          <%= link_to source_path(source), class: "block", data: { turbo_frame: "_top" } do %>
            <span class="font-display font-bold text-charcoal truncate"><%= source.display_name %></span>
          <% end %>
          <div class="text-xs text-charcoal-300 flex items-center flex-wrap gap-x-2 mt-1.5">
            <span><%= source.kind.humanize %></span>
            <% if source.pending? %>
              <% if source.stuck_pending? %>
                <span class="text-cerise font-bold" title="No successful poll yet. Check the jobs dashboard.">stuck</span>
              <% else %>
                <span class="flex items-center gap-1 text-charcoal font-bold">
                  <%= phosphor_icon "spinner-gap", class: "w-3 h-3 animate-spin" %>
                  Resolving…
                </span>
              <% end %>
            <% elsif source.recovering? %>
              <span class="flex items-center gap-1 text-carrot-500 font-bold" title="<%= source.last_error %>">
                <%= phosphor_icon "arrow-clockwise", class: "w-3 h-3 animate-spin" %>
                Retrying<%= " #{time_until(source.next_crawl_at)}" if source.next_crawl_at %>
              </span>
              <% if source.last_error.present? %>
                <span class="text-cerise truncate max-w-[24ch]" title="<%= source.last_error %>"><%= truncate(source.last_error, length: 40) %></span>
              <% end %>
            <% elsif source.failed? %>
              <span class="text-cerise font-bold" title="<%= source.last_error %>">Failed</span>
              <% if source.last_error.present? %>
                <span class="text-cerise truncate max-w-[24ch]" title="<%= source.last_error %>"><%= truncate(source.last_error, length: 40) %></span>
              <% end %>
            <% elsif source.ok? %>
              <span class="text-mint-700 font-bold">OK</span>
            <% end %>
            <% if source.items.unseen.any? %>
              <span class="bg-mint text-charcoal text-[10px] font-bold px-1.5 rounded-full">
                <%= source.items.unseen.count %> new
              </span>
            <% end %>
            <span>· <%= source.items.count %> items</span>
            <% if source.last_polled_at %>
              <span>· polled <%= time_ago(source.last_polled_at) %></span>
            <% end %>
            <% if source.next_crawl_at && source.active? %>
              <span>· next <%= time_ago(source.next_crawl_at) %></span>
            <% end %>
            <% if source.failed? && source.last_error %>
              <span class="text-cerise" title="<%= source.last_error %>">· error</span>
            <% end %>
          </div>
        </div>
      </div>

      <% menu = capture do %>
        <% if source.polling? %>
          <span class="ui-menu-item cursor-wait text-charcoal-300">
            <%= phosphor_icon "spinner-gap", class: "w-3.5 h-3.5 animate-spin" %>
            Pulling…
          </span>
        <% else %>
          <%= button_to pull_source_path(source), method: :post,
                form: { data: { turbo_frame: "_top" } },
                class: ui_menu_item do %>
            <%= phosphor_icon "arrows-clockwise", class: "w-3.5 h-3.5" %>
            Pull now
          <% end %>
        <% end %>

        <% if source.active? %>
          <%= action_link_to source_path(source), method: :patch, params: { source: { active: false } },
                data: { turbo_frame: "_top" },
                class: ui_menu_item do %>
            <%= phosphor_icon "pause", class: "w-3.5 h-3.5" %> Pause
          <% end %>
        <% else %>
          <%= action_link_to source_path(source), method: :patch, params: { source: { active: true } },
                data: { turbo_frame: "_top" },
                class: ui_menu_item do %>
            <%= phosphor_icon "play", class: "w-3.5 h-3.5" %> Unpause
          <% end %>
        <% end %>

        <%= link_to edit_source_path(source),
              data: { turbo_frame: "_top" },
              class: ui_menu_item do %>
          <%= phosphor_icon "pencil-simple", class: "w-3.5 h-3.5" %> Edit
        <% end %>

        <%= action_link_to source_path(source), method: :delete,
              confirm: "Delete this source and all its items?",
              data: { turbo_frame: "_top" },
              class: ui_menu_item(danger: true) do %>
          <%= phosphor_icon "trash", class: "w-3.5 h-3.5" %> Delete
        <% end %>
      <% end %>

      <%= render "shared/ui/dropdown",
            menu_id: "source-actions-#{source.id}",
            trigger_label: "Source actions",
            trigger_class: ui_dropdown_trigger,
            trigger: phosphor_icon("dots-three-vertical", class: "w-4 h-4"),
            menu: menu %>
    </div>
  </div>
<% end %>
