<% @suggestions[:term_hints].each do |word| %>
  <li role="option" class="px-3 py-2 cursor-pointer hover:bg-athens-500"
     data-autocomplete-value="<%= word %>">
    <div class="flex items-center gap-2">
      <span class="text-charcoal-300 text-xs uppercase tracking-wide">Complete to</span>
      <span class="text-charcoal font-medium"><%= sanitize(word) %></span>
    </div>
  </li>
<% end %>

<% if @suggestions[:term_hints].any? && @suggestions[:items].any? %>
  <li role="separator" aria-hidden="true" class="border-b border-charcoal-100"></li>
<% end %>

<% @suggestions[:items].each do |item| %>
  <li role="option" class="px-3 py-2 cursor-pointer hover:bg-athens-500"
     data-autocomplete-href="/items/<%= item.id %>">
    <div class="text-charcoal font-medium"><%= sanitize(item.highlighted_title, tags: %w[mark], attributes: []) %></div>
    <div class="text-charcoal-300 text-xs">
      <%= item.source_name %><%= " · #{time_ago(item.published_at)}" if item.published_at %>
    </div>
  </li>
<% end %>
<% if @suggestions[:term_hints].empty? && @suggestions[:items].empty? %>
  <li class="px-3 py-2 text-charcoal-300 text-sm">No suggestions</li>
<% end %>
