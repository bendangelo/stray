<% title "Forgot password" %>

<main class="flex flex-col items-center justify-center min-h-screen px-5">
  <%= image_tag "stray-logo.svg", alt: "Stray Logo", class: "lg:w-4/12 md:w-5/12 w-6/12 mb-8" %>

  <div class="w-full max-w-md">
    <h1 class="font-display text-2xl font-bold text-charcoal text-center mb-6">Forgot your password?</h1>

    <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "Email", value: params[:email], class: ui_input %>
      </div>

      <div>
        <%= form.submit "Send reset instructions", class: "w-full #{ui_button(size: :lg)}" %>
      </div>
    <% end %>
  </div>
</main>
