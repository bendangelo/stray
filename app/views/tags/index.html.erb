<main class="container mx-auto px-4 pt-4 <%= ui_page(tier: :list) %>">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-display text-2xl font-bold text-charcoal">Tags</h1>
    <%= link_to "New tag", new_tag_path,
      class: ui_button %>
  </div>

  <table class="w-full border-3 border-charcoal rounded-md overflow-hidden">
    <thead class="bg-athens-400 text-charcoal text-sm">
      <tr>
        <th class="px-4 py-2 text-left">Name</th>
        <th class="px-4 py-2 text-left">Items</th>
        <th class="px-4 py-2 text-left">Embedding</th>
        <th class="px-4 py-2 text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "tag", collection: @tags %>
    </tbody>
  </table>

  <% if @pagy.pages > 1 %>
    <div class="mt-4 flex justify-center items-center gap-3">
      <% if @pagy.previous %>
        <%= link_to "← Prev", tags_path(page: @pagy.previous), class: ui_button(variant: :secondary, size: :md) %>
      <% end %>
      <span class="text-sm text-charcoal-300"><%= @pagy.page %> / <%= @pagy.pages %></span>
      <% if @pagy.next %>
        <%= link_to "Next →", tags_path(page: @pagy.next), class: ui_button(variant: :secondary, size: :md) %>
      <% end %>
    </div>
  <% end %>
</main>
