<main class="container mx-auto px-4 pt-4 max-w-screen-xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-display text-2xl font-bold text-charcoal">Tags</h1>
    <%= link_to "New tag", new_tag_path,
      class: "h-10 px-4 bg-carrot-500 hover:bg-carrot-600 text-white font-medium rounded-md border-3 border-charcoal" %>
  </div>

  <table class="w-full border-3 border-charcoal rounded-md overflow-hidden">
    <thead class="bg-athens-400 text-charcoal text-sm">
      <tr>
        <th class="px-4 py-2 text-left">Name</th>
        <th class="px-4 py-2 text-left">Items</th>
        <th class="px-4 py-2 text-left">Embedding</th>
        <th class="px-4 py-2 text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "tag", collection: @tags %>
    </tbody>
  </table>

  <% if @pagy.pages > 1 %>
    <div class="mt-4 flex justify-center gap-2 text-sm">
      <% if @pagy.previous %>
        <%= link_to "← Prev", tags_path(page: @pagy.previous), class: "text-charcoal underline hover:no-underline" %>
      <% end %>
      <span class="text-charcoal-300"><%= @pagy.page %> / <%= @pagy.pages %></span>
      <% if @pagy.next %>
        <%= link_to "Next →", tags_path(page: @pagy.next), class: "text-charcoal underline hover:no-underline" %>
      <% end %>
    </div>
  <% end %>
</main>
