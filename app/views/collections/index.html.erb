<% title "Collections" %>

<main class="container mx-auto px-4 pt-4 <%= ui_page(tier: :list) %>">
  <div class="flex items-center justify-between mb-4">
    <h1 class="font-display text-2xl font-bold text-charcoal">Collections</h1>
    <%= link_to "+ New collection", new_collection_path,
          class: ui_button %>
  </div>

  <% if @collections.any? %>
    <div class="space-y-3">
      <%= render partial: "collections/collection", collection: @collections %>
    </div>
  <% else %>
    <%= render "shared/ui/empty_state", message: "No collections yet." %>
  <% end %>
</main>
