<% title @item.title %>
<% follow = @item.source.follows.detect { |f| f.user_id == current_user.id } %>

<div class="container mx-auto px-4 pt-4 max-w-3xl">
  <div class="mb-2">
    <%= link_to "← Back", back_to_feed_path, class: "text-sm text-charcoal underline hover:no-underline" %>
  </div>

  <header class="mb-4">
    <h1 class="font-display text-2xl font-bold text-charcoal"><%= @item.title %></h1>
    <div class="flex flex-wrap items-center gap-2 mt-2 text-xs text-charcoal-300">
      <%= link_to @item.source.display_name, source_path(@item.source), class: "hover:text-carrot-600 underline" %>
      <span>· <%= time_ago(@item.published_at) %></span>
      <% if @item.duration.present? %>
        <span>· <%= pretty_duration(@item.duration) %></span>
      <% end %>
      <%= link_to @item.url, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-1 text-carrot-600 hover:underline" do %>
        Open at source <%= phosphor_icon "arrow-up-right", class: "w-3 h-3" %>
      <% end %>
      <%= render "items/actions_menu", item: @item %>
    </div>
  </header>

  <section class="mb-6">
    <% if video?(@item) %>
      <% embed = embed_url(@item) %>
      <% if embed %>
        <iframe src="<%= embed %>" title="<%= @item.title %>" frameborder="0"
                class="w-full aspect-video rounded-md border-3 border-charcoal"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen></iframe>
      <% elsif @item.thumbnail_url.present? %>
        <img class="object-cover w-full aspect-video rounded-md border-3 border-charcoal"
             src="<%= @item.thumbnail_url %>" alt="<%= @item.title %>">
      <% end %>

      <% if @item.content_text.present? %>
        <div class="prose prose-sm max-w-none mt-4 whitespace-pre-line text-charcoal"><%= @item.content_text %></div>
      <% end %>

      <div class="mt-4">
        <%= render "items/download_command", item: @item %>
      </div>
    <% elsif @item.content_html.present? %>
      <article class="prose prose-sm max-w-none">
        <%= sanitize @item.content_html, scrubber: ArticleBodyScrubber.new %>
      </article>
    <% else %>
      <% if @item.thumbnail_url.present? %>
        <img class="object-cover w-full aspect-video rounded-md border-3 border-charcoal mb-4"
             src="<%= @item.thumbnail_url %>" alt="<%= @item.title %>">
      <% end %>
      <% if @item.content_text.present? %>
        <div class="prose prose-sm max-w-none whitespace-pre-line text-charcoal"><%= @item.content_text %></div>
      <% end %>
    <% end %>
  </section>

  <% if @item.taggings.includes(:tag).any? %>
    <section class="mb-6">
      <h2 class="text-xs uppercase tracking-wide text-charcoal-300 mb-2">Tags</h2>
      <div class="flex flex-wrap gap-2">
        <% @item.taggings.includes(:tag).each do |tagging| %>
          <div class="inline-flex items-center gap-1">
            <%= link_to tagging.tag.name,
                  root_path(request.query_parameters.except("page").merge(tag: tagging.tag.name)),
                  class: "inline-flex items-center px-2 py-0.5 text-xs rounded bg-athens-300 text-charcoal hover:bg-carrot-500 hover:text-white" %>
            <span title="Tagged by <%= tagging.source %>" class="text-charcoal-300">
              <%= tagging_provenance_icon(tagging) %>
            </span>          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if follow %>
    <% exp = ranking_explanation_for(@item, follow) %>
    <section class="mb-6 border-3 border-charcoal rounded-md bg-athens-400 p-3">
      <h2 class="text-xs uppercase tracking-wide text-charcoal-300 mb-2">Why is this here?</h2>
      <div class="space-y-0.5 text-xs text-charcoal">
        <p>Published <%= time_ago(exp.published_at) %>.</p>
        <p>Weight <%= exp.weight %> from <%= @item.source.display_name %> — <%= offset_label(exp.offset_hours) %>.</p>
        <p>Shown as if published <%= time_ago(exp.effective_at) %>.</p>
        <% if exp.muted %>
          <p class="text-cerise">Source muted (3+ hides in the last week).</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% prev_item, next_item = @neighbors %>
  <nav class="flex justify-between items-center mt-8 pt-4 border-t-3 border-charcoal gap-2">
    <div class="min-w-0 flex-1">
      <% if prev_item %>
        <%= link_to item_path(prev_item, context_params_for(prev_item)),
              class: "block text-sm text-charcoal hover:text-carrot-600 truncate" do %>
          <span class="text-charcoal-300 text-xs">Previous</span><br>
          <%= phosphor_icon "caret-left", class: "w-3 h-3 inline" %> <%= prev_item.title %>
        <% end %>
      <% end %>
    </div>
    <div class="min-w-0 flex-1 text-right">
      <% if next_item %>
        <%= link_to item_path(next_item, context_params_for(next_item)),
              class: "block text-sm text-charcoal hover:text-carrot-600 truncate" do %>
          <span class="text-charcoal-300 text-xs">Next</span><br>
          <%= next_item.title %> <%= phosphor_icon "caret-right", class: "w-3 h-3 inline" %>
        <% end %>
      <% end %>
    </div>
  </nav>
</div>
