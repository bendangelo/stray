<div class="flex flex-col lg:flex-row relative py-6 lg:py-10 px-3 max-w-screen-lg mx-auto">
  <% embed = embed_url(item) %>
  <% if embed %>
    <iframe src="<%= embed %>"
            title="<%= item.title %>"
            frameborder="0"
            class="w-full lg:w-1/2 aspect-video lg:mx-6 rounded-md border-3 border-charcoal"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen>
    </iframe>
  <% elsif item.thumbnail_url.present? %>
    <img class="object-cover w-full lg:mx-6 lg:w-1/2 h-72 lg:h-96 rounded-md border-3 border-charcoal"
         src="<%= item.thumbnail_url %>" alt="<%= item.title %>">
  <% end %>

  <div class="flex-1 mt-4 lg:mt-0 lg:ml-3 lg:mr-12">
    <div class="flex items-start gap-2 mb-1">
      <a class="block text-lg font-semibold hover:underline md:text-xl flex-1 min-w-0"
         href="<%= item.url %>" target="_blank" rel="noopener">
        <%= item.title %>
      </a>
      <%= render "items/actions_menu", item: item %>
    </div>

    <% if item.source.name.present? %>
      <div class="flex mb-3 items-center gap-2">
        <% if (icon = source_icon_url(item.source)) %>
          <img src="<%= icon %>" alt="" loading="lazy"
               class="w-5 h-5 rounded border-2 border-charcoal object-cover">
        <% end %>
        <div>
          <%= link_to item.source.name, source_path(item.source),
            class: "text-gray-800 text-sm hover:text-black hover:underline" %>
          <p class="text-gray-800 text-xs mt-1">
            <%= time_ago(item.published_at) %>
            <% if item.duration.present? %>
              · <%= pretty_duration(item.duration) %>
            <% end %>
          </p>
        </div>
      </div>
    <% end %>

    <%= render "items/why", item: item %>

    <% if item.content_text.present? %>
      <p class="text-sm text-gray-500 md:text-sm whitespace-pre-line">
        <%= truncate(item.content_text, length: 500) %>
      </p>
    <% end %>
  </div>

  <button type="button" aria-label="Close"
          class="absolute top-2 right-2 w-6 h-6 z-10"
          data-action="click->player#close">
    <%= phosphor_icon "x", class: "text-charcoal hover:text-carrot w-full h-full" %>
  </button>

  <div class="flex absolute bottom-3 right-3">
    <button type="button" aria-label="Previous" id="video-prev"
            class="w-10 h-10"
            data-action="click->player#prev">
      <%= phosphor_icon "caret-left", class: "text-charcoal hover:text-cerise w-full h-full" %>
    </button>
    <button type="button" aria-label="Next" id="video-next"
            class="w-10 h-10"
            data-action="click->player#next">
      <%= phosphor_icon "caret-right", class: "text-charcoal hover:text-cerise w-full h-full" %>
    </button>
  </div>
</div>
