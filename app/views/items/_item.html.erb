<div id="<%= dom_id(item) %>"
     class="group col-span-6 sm:col-span-4 md:col-span-3 xl:col-span-2"
     data-player-target="video"
     data-url="<%= player_item_path(item) %>">
  <div class="flex flex-col">
    <div class="relative overflow-hidden">
      <a href="#" data-action="click->player#toggle:prevent">
        <%= fallback_image_tag(item.thumbnail_url,
              alt: item.title,
              class: "group-hover:border-2 border-carrot-400 object-cover w-full aspect-video rounded-md border-3 border-charcoal") %>
      </a>
      <% if video?(item) %>
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition">
          <%= phosphor_icon "play", style: :fill, class: "w-10 h-10 text-white/80" %>
        </div>
      <% end %>
      <%= source_icon_tag(item.source,
            size: "w-5 h-5",
            class: "absolute left-2 bottom-2") %>
      <% if item.duration.present? %>
        <p class="absolute right-2 bottom-2 bg-charcoal/80 backdrop-blur-sm text-champagne text-xs px-1.5 py-0.5 rounded">
          <%= pretty_duration(item.duration) %>
        </p>
      <% end %>
    </div>

    <div class="flex mt-1 items-start gap-1">
      <div class="flex-1 min-w-0">
        <a href="<%= item.url %>" target="_blank" rel="noopener" title="<%= item.title %>"
           class="hover:underline break-words text-charcoal text-sm font-semibold line-clamp-2">
          <%= item.title %>
        </a>
      </div>

      <%= render "items/actions_menu", item: item %>
    </div>

    <div class="flex justify-between items-center gap-2 mt-1 text-xs text-charcoal-300">
      <%= link_to item.source.display_name, source_path(item.source), class: "hover:text-carrot-600 underline truncate min-w-0" %>
      <span class="shrink-0"><%= time_ago(item.published_at) %></span>
    </div>

    <div id="item_<%= item.id %>_tags" class="hidden"></div>
  </div>
</div>
