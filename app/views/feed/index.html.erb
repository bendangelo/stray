<% if @saved %>
  <% title "Saved" %>
  <% description "Items you saved in your Stray feed." %>
<% elsif @tag %>
  <% title "##{@tag}" %>
  <% description "Items tagged ##{@tag} in your Stray feed." %>
<% elsif @q.present? %>
  <% title %(Search: "#{@q}") %>
  <% description %(Search results for "#{@q}" in your Stray feed.) %>
<% else %>
  <% title "Feed" %>
<% end %>

<% content_for :tag_bar do %>
  <%= render "shared/tag_bar" %>
<% end %>

<% content_for :muted_toggle do %>
  <%= render "shared/muted_toggle" %>
<% end %>

<div class="container mx-auto px-4 pt-4 max-w-screen-xl xl:max-w-screen-2xl">
  <% if @items.any? %>
    <div class="grid grid-cols-12 gap-y-4 mx-auto mb-4 gap-x-2"
         data-controller="player">
      <div class="col-span-12 hidden border-y-3 border-charcoal"
           data-player-target="playerBox">
        <p class="p-4 text-center text-charcoal-300">Loading...</p>
      </div>

      <%= render partial: "items/item", collection: @items, as: :item %>
    </div>
  <% else %>
    <div class="border-3 border-charcoal rounded-md bg-athens-400 p-8 text-center">
      <p class="text-charcoal-300">
        <% if @q.present? || @tag.present? %>
          No results<% if @q.present? %> for "<%= @q %>"<% end %><% if @tag.present? %> tagged "<%= @tag %>"<% end %>.
        <% elsif @saved %>
          No saved items yet.
        <% elsif @browse_empty %>
          You're all caught up. <%= link_to "View saved items", root_path(saved: 1), class: "underline hover:no-underline" %>.
        <% else %>
          Your feed is empty. Add a link above to start following sources.
        <% end %>
      </p>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="mt-4 flex justify-center items-center gap-3">
      <% if @pagy.previous %>
        <%= link_to "← Newer", root_path(request.query_parameters.merge(page: @pagy.previous)),
          class: ui_button(variant: :secondary, size: :md) %>
      <% end %>
      <span class="text-sm text-charcoal-300"><%= @pagy.page %> / <%= @pagy.pages %></span>
      <% if @pagy.next %>
        <%= link_to "Older →", root_path(request.query_parameters.merge(page: @pagy.next)),
          class: ui_button(variant: :secondary, size: :md) %>
      <% end %>
    </div>
  <% end %>
</div>
