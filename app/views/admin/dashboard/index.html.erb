<% title "Admin" %>

<main class="max-w-4xl mx-auto px-5 py-8 pb-20">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-display text-2xl font-bold text-charcoal">Admin</h1>
    <div class="flex items-center gap-4 text-sm">
      <%= link_to "Settings", admin_settings_path, class: "text-charcoal underline hover:no-underline" %>
      <%= link_to "Jobs", admin_mission_control_jobs_path, class: "text-charcoal underline hover:no-underline" %>
    </div>
  </div>

  <section class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
    <% @counts.each do |label, count| %>
      <div class="border-3 border-charcoal rounded-md p-4 bg-athens-400">
        <p class="text-3xl font-bold text-charcoal"><%= count %></p>
        <p class="text-sm text-charcoal-300 capitalize"><%= label.to_s %></p>
      </div>
    <% end %>
  </section>

  <section class="grid md:grid-cols-2 gap-8">
    <div>
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1 mb-3">
        Recent users
        <%= link_to "Manage users", admin_users_path, class: "text-sm font-normal text-charcoal underline ml-2" %>
      </h2>
      <ul class="space-y-2">
        <% @recent_users.each do |user| %>
          <li class="flex items-center justify-between text-sm">
            <span class="text-charcoal"><%= user.username %> <span class="text-charcoal-300">· <%= user.email %></span></span>
            <span class="text-xs <%= user.admin? ? "text-mint-700" : "text-charcoal-300" %>"><%= user.admin? ? "admin" : "user" %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div>
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1 mb-3">Recent items</h2>
      <ul class="space-y-2">
        <% @recent_items.each do |item| %>
          <li class="text-sm text-charcoal truncate">
            <%= link_to item.title, item.url, target: "_blank", rel: "noopener", class: "hover:underline" %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
  <section class="mt-8">
    <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1 mb-3">Poll errors</h2>
    <% if @poll_errors.any? %>
      <ul id="poll-errors" class="space-y-3">
        <% @poll_errors.each do |source| %>
          <li class="text-sm">
            <div class="flex items-center justify-between">
              <%= link_to source.display_name, source_path(source), class: "text-charcoal underline hover:no-underline" %>
              <span class="text-xs text-charcoal-300"><%= time_ago_in_words(source.last_error_at) %> ago</span>
            </div>
            <p class="text-charcoal-300 truncate"><%= source.last_error %></p>
            <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded <%= source.failed? ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800" %>">
              <%= source.status %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p id="poll-errors" class="text-sm text-charcoal-300">No poll errors.</p>
    <% end %>
  </section>
</main>
