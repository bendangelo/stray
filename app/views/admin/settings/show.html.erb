<% title "Settings" %>

<main class="max-w-2xl mx-auto px-5 py-8 pb-20">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-display text-2xl font-bold text-charcoal">Settings</h1>
    <%= link_to "Jobs dashboard", admin_mission_control_jobs_path, class: "text-sm text-charcoal underline hover:no-underline" %>
  </div>

  <%= form_with model: @setting, url: admin_settings_path, method: :patch, class: "space-y-8" do |form| %>
    <% if @setting.errors.any? %>
      <div class="px-4 py-3 border-3 border-cerise text-cerise text-sm">
        <% @setting.errors.full_messages.each do |msg| %>
          <div><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <section class="space-y-4">
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1">Instance</h2>

      <div>
        <%= form.label :instance_name, class: ui_label %>
        <%= form.text_field :instance_name,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :instance_domain, class: ui_label %>
        <%= form.text_field :instance_domain,
          class: ui_input %>
        <p class="text-xs text-charcoal-300 mt-1">Changes to instance domain require an app restart to take effect for host validation.</p>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1">AI Provider</h2>

      <div>
        <%= form.label :ai_provider_name, "Provider", class: ui_label %>
        <%= form.select :ai_provider_name,
          options_for_select(Setting::VALID_AI_PROVIDERS, @setting.ai_provider_name),
          {},
          class: ui_select %>
      </div>

      <div>
        <%= form.label :ai_provider_url, "URL", class: ui_label %>
        <%= form.text_field :ai_provider_url,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :ai_provider_api_key, "API key", class: ui_label %>
        <%= form.password_field :ai_provider_api_key,
          placeholder: @setting.ai_provider_api_key.present? ? "••••••••" : "",
          class: ui_input %>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1">Tagging</h2>

      <div>
        <%= form.label :llm_tagging_enabled, "Enable LLM tagging", class: ui_label %>
        <%= form.check_box :llm_tagging_enabled,
          class: "h-6 w-6 border-3 border-charcoal" %>
        <p class="text-xs text-charcoal-300 mt-1">When AI provider is set, uses LLM to suggest tags. Off by default.</p>
      </div>

      <div>
        <%= form.label :llm_tagging_model, "LLM model", class: ui_label %>
        <%= form.text_field :llm_tagging_model,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :zero_shot_threshold, "Zero-shot threshold", class: ui_label %>
        <%= form.number_field :zero_shot_threshold, step: 0.01, min: 0, max: 1,
          class: ui_input %>
        <p class="text-xs text-charcoal-300 mt-1">Cosine similarity required to auto-assign a tag. Lower = more tags.</p>
      </div>

      <div>
        <%= form.label :zero_shot_top_n, "Max tags per item", class: ui_label %>
        <%= form.number_field :zero_shot_top_n, min: 1, max: 20,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :embedding_model, "Embedding model (provider)", class: ui_label %>
        <%= form.text_field :embedding_model,
          class: ui_input %>
      </div>

      <% if @setting.ai_provider_name == "NONE" %>
        <div class="border-3 border-charcoal rounded-md p-4 bg-athens-400">
          <p class="text-sm font-medium text-charcoal mb-2">Embedding Model</p>
          <% if @setting.embedding_model_present %>
            <p class="text-mint-700 text-sm">✓ Model downloaded</p>
          <% else %>
            <p class="text-charcoal-300 text-sm mb-2">Model not downloaded. Auto-tagging needs this.</p>
            <%= button_to "Download model", download_model_admin_settings_path,
              class: ui_button(size: :sm) %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="space-y-4">
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1">Crawling</h2>

      <div>
        <%= form.label :polite_crawl_delay, "Delay between requests (seconds)", class: ui_label %>
        <%= form.number_field :polite_crawl_delay, step: 0.1, min: 0,
          class: ui_input %>
        <p class="text-xs text-charcoal-300 mt-1">Be polite to sites you pull from. Applied before each request. 0 = no delay.</p>
      </div>

      <div>
        <%= form.label :publication_buffer_minutes, "Publication buffer (minutes)", class: ui_label %>
        <%= form.number_field :publication_buffer_minutes, min: 0,
          class: ui_input %>
        <p class="text-xs text-charcoal-300 mt-1">Adaptive sources are polled this long after the predicted publish time, so content is available before we fetch.</p>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="font-display text-lg font-bold text-charcoal border-b-3 border-charcoal pb-1">SMTP</h2>

      <div>
        <%= form.label :smtp_host, "Host", class: ui_label %>
        <%= form.text_field :smtp_host,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :smtp_port, "Port", class: ui_label %>
        <%= form.number_field :smtp_port,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :smtp_username, "Username", class: ui_label %>
        <%= form.text_field :smtp_username,
          class: ui_input %>
      </div>

      <div>
        <%= form.label :smtp_password, "Password", class: ui_label %>
        <%= form.password_field :smtp_password,
          placeholder: @setting.smtp_password.present? ? "••••••••" : "",
          class: ui_input %>
      </div>
    </section>

    <div>
      <%= form.submit "Save settings",
        class: ui_button(size: :lg) %>
    </div>
  <% end %>
</main>
